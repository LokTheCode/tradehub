# Copy this file to .env

# paper = virtual money (safe, default). angelone = REAL money.
BROKER=paper

# price source: yfinance (real, delayed) or sim (fake random-walk, works offline)
MARKET_DATA=yfinance

# Virtual starting cash for paper mode (INR)
PAPER_START_CASH=100000

# ---- Real trading (only when BROKER=angelone) ----
# You must type exactly I_UNDERSTAND to allow real orders.
LIVE_TRADING_CONFIRM=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Safety cap: reject any single live order bigger than this value (INR)
LIVE_MAX_ORDER_VALUE=5000
